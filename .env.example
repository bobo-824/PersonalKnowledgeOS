# Personal Knowledge OS —— 本地配置模板
#
# 用法：把本文件复制为 .env，再按注释修改。
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
#
# .env 已被 .gitignore 排除，不会进入版本库。
# 本文件（.env.example）只放占位符，绝不填写真实密钥。

# ===== 服务端口 =====
# 单端口模式：FastAPI 同时提供 /api 和前端页面，浏览器访问 http://127.0.0.1:8000
PKOS_PORT=8000
PKOS_HOST=127.0.0.1

# 开发模式下的前端 Vite 端口（仅 start.ps1 -Dev 时使用）
PKOS_FRONTEND_PORT=5173

# ===== 数据目录 =====
# SQLite 数据库、备份、日志都放在这里。
# 请保持在非同步目录（不要放进 OneDrive），否则活动数据库有损坏风险。
# 留空则默认为项目根目录下的 data\
PKOS_DATA_DIR=

# ===== AI 模型配置（阶段 2）=====
# 采用 Provider 抽象层，支持 OpenAI API 及其兼容接口。
# 换供应商只改下面这几行，代码不动（DECISIONS D-038）。
# 密钥只从环境变量读取，不写进前端代码、日志或版本库。
#
# 这几项也可以不手动编辑：启动后打开「设置」页填，保存会写回本文件。
# 写完立刻生效，不用重启；但**界面上读不回密钥原文**（只显示末 4 位），
# 想删掉密钥只能回来编辑这一行。
#
# BASE_URL 要填到版本路径为止，也就是**以 /v1 结尾**。
# 代码只在它后面接 /chat/completions，不猜、不自动补 /v1。
#   对： https://api.example.com/v1
#   错： https://api.example.com/v1/chat/completions
#   错： https://api.example.com          ← 少了 /v1 会 404/400
#
# API_KEY 只有远程服务需要。本地 Ollama / LM Studio 不校验密钥，
# 所以「地址和模型名填了、密钥留空」是合法状态，不是配置失败。
PKOS_AI_PROVIDER=
PKOS_AI_BASE_URL=
PKOS_AI_API_KEY=
PKOS_AI_MODEL=
PKOS_AI_TIMEOUT_SECONDS=60
# 服务端 JSON mode。各家兼容端点支持参差不齐，贸然开启会整批请求 400，
# 所以默认 false；确认你的服务端支持之后再打开。
# 输出校验由后端 Pydantic 兜底（硬约束 C3），开不开都不影响安全性。
PKOS_AI_JSON_MODE=false

# ===== 行为开关 =====
# 日志级别：DEBUG / INFO / WARNING / ERROR
PKOS_LOG_LEVEL=INFO

# 是否在前端未构建时返回提示页（true 便于阶段 0 单独验证后端）
PKOS_ALLOW_MISSING_FRONTEND=true
